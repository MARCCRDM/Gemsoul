--[[
	Archives the surge and maneuver catalog as it stands, before the Attack /
	Defense / Shift rework (docs/surge-archive). Nothing is deleted by the
	rework; this records every ability, its numbers, its icon and every file
	that uses it, so owned gems can be converted and old abilities restored.

	  lune run tools/archive_surges.luau [repo]

	Writes docs/surge-archive/legacy-surges.json and legacy-surges.md.
]]
local fs = require("@lune/fs")
local luau = require("@lune/luau")
local process = require("@lune/process")
local roblox = require("@lune/roblox")
local serde = require("@lune/serde")

local ROOT = process.args[1] or "."
local cache = {}
local function load(name)
	if cache[name] then
		return cache[name]
	end
	local source = fs.readFile(ROOT .. "/src/shared/" .. name .. ".luau")
	local env = setmetatable({
		Color3 = roblox.Color3,
		Vector3 = roblox.Vector3,
		script = { Parent = setmetatable({}, { __index = function(_, key)
			return key
		end }) },
		require = function(module)
			return load(module)
		end,
	}, { __index = _G })
	cache[name] = luau.load(source, { debugName = name, environment = env })()
	return cache[name]
end

local Tech = load("CombatTechnology")
local GemRoller = load("GemRoller")
local Icons = luau.load(fs.readFile(ROOT .. "/src/client/Modules/AbilityIconAtlas.luau"))()

-- Where each id is mined: element, rarity tier slot, base / variant / resonance.
local source = {}
local tierNames = GemRoller.TierNames or {}
for element, list in GemRoller.Surges do
	for tier, id in list do
		source[id] = { Element = element, Tier = tier, Line = "Base" }
	end
end
for element, list in GemRoller.SurgeVariants or {} do
	for tier, id in list do
		source[id] = { Element = element, Tier = tier, Line = "Variant" }
	end
end
for tier, id in GemRoller.Resonance or {} do
	source[id] = { Element = "Any", Tier = tier, Line = "Resonance" }
end
for tier, id in GemRoller.ResonanceVariants or {} do
	source[id] = { Element = "Any", Tier = tier, Line = "Resonance variant" }
end

-- Every source file, read once, for "used in".
local files = {}
local function walk(dir)
	for _, name in fs.readDir(dir) do
		local path = dir .. "/" .. name
		if fs.isDir(path) then
			walk(path)
		elseif string.match(name, "%.luau$") then
			table.insert(files, { Path = string.sub(path, #ROOT + 2), Text = fs.readFile(path) })
		end
	end
end
walk(ROOT .. "/src")
table.sort(files, function(a, b)
	return a.Path < b.Path
end)
local function usedIn(id)
	local out = {}
	for _, file in files do
		if string.find(file.Text, "%f[%w]" .. id .. "%f[^%w]") then
			table.insert(out, file.Path)
		end
	end
	return out
end

-- Plain values only (colours become text).
local function plain(value)
	if type(value) == "table" then
		local out = {}
		for k, v in value do
			out[k] = plain(v)
		end
		return out
	elseif type(value) == "number" or type(value) == "string" or type(value) == "boolean" then
		return value
	end
	return tostring(value)
end

local ids = {}
for id in Tech.Catalog do
	table.insert(ids, id)
end
table.sort(ids, function(a, b)
	local sa, sb = source[a], source[b]
	if (sa ~= nil) ~= (sb ~= nil) then
		return sa == nil -- maneuvers first
	end
	if sa and sb and sa.Element ~= sb.Element then
		return sa.Element < sb.Element
	end
	if sa and sb and sa.Tier ~= sb.Tier then
		return sa.Tier < sb.Tier
	end
	return a < b
end)

local entries = {}
for _, id in ids do
	local definition = Tech.Catalog[id]
	local mined = source[id]
	table.insert(entries, {
		Id = id,
		Name = definition.Name,
		Kind = if mined then "Gem Surge" else "Rig Maneuver",
		Element = if mined then mined.Element else definition.Element,
		Tier = if mined then mined.Tier else nil,
		TierName = if mined then tierNames[mined.Tier] else nil,
		Line = if mined then mined.Line else nil,
		Icon = Icons.Index[id],
		Definition = plain(definition),
		UsedIn = usedIn(id),
	})
end

local out = ROOT .. "/docs/surge-archive"
if not fs.isDir(out) then
	fs.writeDir(out)
end
fs.writeFile(
	out .. "/legacy-surges.json",
	serde.encode("json", {
		Note = "Catalog before the Attack / Defense / Shift rework. Generated by tools/archive_surges.luau.",
		Icons = "assets/images/ability_icons.png (Index = cell; Cell = 128 px, 8 columns)",
		Abilities = entries,
	}, true)
)

local function cell(value)
	return (string.gsub(tostring(value or ""), "|", "/"))
end
local lines = {
	"# Legacy surges and maneuvers",
	"",
	"The catalog as it stood before the Attack / Defense / Shift rework, generated by",
	"`tools/archive_surges.luau`. Full numbers for every ability are in `legacy-surges.json`.",
	"",
	string.format("%d abilities: %d gem surges and %d rig maneuvers.", #entries, (function()
		local n = 0
		for _, e in entries do
			n += if e.Kind == "Gem Surge" then 1 else 0
		end
		return n
	end)(), (function()
		local n = 0
		for _, e in entries do
			n += if e.Kind == "Rig Maneuver" then 1 else 0
		end
		return n
	end)()),
	"",
	"| Id | Name | Kind | Element | Tier | Line | Cost | Cooldown (s) | Icon cell | Description |",
	"| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |",
}
for _, e in entries do
	local d = e.Definition
	table.insert(
		lines,
		string.format(
			"| %s | %s | %s | %s | %s | %s | %s %s | %s | %s | %s |",
			e.Id,
			cell(e.Name),
			e.Kind,
			cell(e.Element or "None"),
			cell(if e.Tier then string.format("%d %s", e.Tier, e.TierName or "") else ""),
			cell(e.Line),
			cell(d.Cost),
			cell(d.Resource),
			cell(d.Cooldown),
			cell(e.Icon),
			cell(d.Description)
		)
	)
end
table.insert(lines, "")
table.insert(lines, "## Where each one is used")
table.insert(lines, "")
for _, e in entries do
	table.insert(lines, string.format("- **%s**: %s", e.Id, table.concat(e.UsedIn, ", ")))
end
table.insert(lines, "")
fs.writeFile(out .. "/legacy-surges.md", table.concat(lines, "\n"))
print(string.format("Archived %d abilities to %s", #entries, out))
