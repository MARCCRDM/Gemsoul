-- A shooter's volleys outside a battle (KaijuFight.Styles' Ranged): as a
-- Razorback's, under its own name and look (Shot nil: a bolt in its element).
local function volley(name: string, shot: string?)
	return {
		Name = name,
		Shot = shot,
		Combo = 2,
		HopBack = 12,
		HopEvery = 2.5,
		Keep = { 11, 17 },
		Reach = 26,
		Volleys = 3,
		Every = 1.4,
		Windup = 0.5,
		Shots = 3,
		Gap = 0.15,
		Mult = 0.5,
	}
end

