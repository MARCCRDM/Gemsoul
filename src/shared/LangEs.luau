	["Coming soon: revives aren't on sale yet."] = "Muy pronto: los revivir aún no están a la venta.",
	["Your kaiju are back on their feet!"] = "¡Tus kaiju están de pie otra vez!",
	["Your kaiju is back on its feet!"] = "¡Tu kaiju está de pie otra vez!",
	["{=} is back on its feet!"] = "¡{=} está de pie otra vez!",
	["{=} is back on its feet, but weak: heal with gems before the next fight."] = "{=} está de pie otra vez, pero débil: cúralo con gemas antes de la próxima pelea.",
	["{=} was knocked out! It's back by itself in {=}, or revive it now."] = "¡{=} quedó noqueado! Vuelve solo en {=}, o revívelo ahora.",
	["{=} is knocked out: it's back by itself in {=}, or revive it now."] = "{=} está noqueado: vuelve solo en {=}, o revívelo ahora.",
	["Not in the middle of a fight: get clear of the critters first."] = "No en medio de un combate: aléjate primero de las criaturas.",
	["{1} kaiju back on their feet!"] = "¡{1} kaiju de pie otra vez!",
	["None of your kaiju is knocked out."] = "Ninguno de tus kaiju está noqueado.",
	["Kaiju Revive"] = "Revivir kaiju",
	["{*} is yours!"] = "¡{*} es tuyo!",
	-- Swing restores: the arena tournament, dungeon clears, coupons
	-- (Shared.SwingRestore; the duel result, SocialUI).
	["TOURNAMENT WON!"] = "¡TORNEO GANADO!",
	["+{1} swings restored"] = "+{1} golpes recuperados",
	["Tournament win {1} / {2}"] = "Victoria de torneo {1} / {2}",
	["your swings are full"] = "tus golpes están al máximo",
	["Same opponent twice running: this win doesn't count"] = "El mismo rival dos veces seguidas: esta victoria no cuenta",
	["win {1} restores {2}% swings"] = "la victoria {1} recupera {2}% de golpes",
	["Tournament run over"] = "Racha de torneo terminada",
	["your next win restores {1}% swings"] = "tu próxima victoria recupera {1}% de golpes",
	-- Reward coupons (Shared.Coupons): the INVITE window's COUPONS tab
	-- (ReferralUI), spending them (CouponServer).
	["FRIEND REWARDS"] = "RECOMPENSAS POR AMIGOS",
	["COUPONS"] = "CUPONES",
	["COUPONS  ·  {1}"] = "CUPONES  ·  {1}",
	["Your reward coupons"] = "Tus cupones de recompensa",
	["Every friend who joins on your invite gives you one of each. Use them whenever you like."] = "Cada amigo que se une con tu invitación te da uno de cada uno. Úsalos cuando quieras.",
	["XP BOOST"] = "XP EXTRA",
	["Swing Restore"] = "Recuperar golpes",
	["Double XP"] = "XP doble",
	["Half your pick's swings back."] = "Recupera la mitad de los golpes de tu pico.",
	["Your knocked-out kaiju back now."] = "Tus kaiju noqueados vuelven ya.",
	["Double XP for {1} minutes."] = "XP doble durante {1} minutos.",
	["USE"] = "USAR",
	["NONE YET"] = "AÚN NINGUNO",
	["Using…"] = "Usando…",
	["INVITE A FRIEND FOR MORE"] = "INVITA A UN AMIGO PARA MÁS",
	["Swing Restore works while your swings are down; Kaiju Revive while one is knocked out."] = "Recuperar golpes sirve cuando te faltan golpes; Revivir kaiju, cuando uno está noqueado.",
	["No coupons yet: invite a friend and you get one of each when they join."] = "Aún no tienes cupones: invita a un amigo y recibirás uno de cada uno cuando se una.",
	["That isn't a coupon."] = "Eso no es un cupón.",
	["You have no {*} coupons. Invite a friend for more!"] = "No tienes cupones de {*}. ¡Invita a un amigo para conseguir más!",
	["Your pick's swings are full: keep it for when they run low."] = "Los golpes de tu pico están al máximo: guárdalo para cuando te falten.",
	["None of your kaiju is knocked out: keep it for when one is."] = "Ninguno de tus kaiju está noqueado: guárdalo para cuando lo esté.",
	["Double XP for {1} minutes!"] = "¡XP doble durante {1} minutos!",
	["A friend joined on your invite: +{1} reward coupons! Open INVITE to use them."] = "Un amigo se unió con tu invitación: ¡+{1} cupones de recompensa! Abre INVITAR para usarlos.",
	-- The Saga Shelter's crew (Shared.Vendors, Client.Dialogue): Ilsa buys
	-- gems, Brutus runs the Uplink, Tamsin the Market, Borin the Store,
	-- Garrick the quarry. Staff on a working base: plain, exact, tú.
	-- (Their roles are kept free of gender.)
	["►  {*}"] = "►  {*}",
	["Talk"] = "Hablar",
	["Goodbye"] = "Adiós",
	["ILSA // GEM BUYER"] = "ILSA // COMPRA DE GEMAS",
	["BRUTUS // ARENA MASTER"] = "BRUTUS // GUÍA DE LA ARENA",
	["TAMSIN // TRADE BROKER"] = "TAMSIN // AGENTE DE COMERCIO",
	["BORIN // OUTFITTER"] = "BORIN // ESTILISTA",
	["GARRICK // MINING FOREMAN"] = "GARRICK // CAPATAZ DE MINERÍA",
	["Ilsa, Gem Buyer"] = "Ilsa, compra de gemas",
	["Brutus, Arena Master"] = "Brutus, guía de la arena",
	["Tamsin, Trade Broker"] = "Tamsin, agente de comercio",
	["Borin, Outfitter"] = "Borin, estilista",
	["Garrick, Mining Foreman"] = "Garrick, capataz de minería",
	["Ilsa, gem buyer. I grade loose gems and pay coins on the spot, at the Market rate. Gems your loadouts use are never part of an offer."] = "Ilsa, compra de gemas. Califico gemas sueltas y pago en monedas al momento, al precio del Mercado. Las gemas que usan tus equipamientos nunca entran en una oferta.",
	["Appraise my spare gems"] = "Tasar mis gemas de sobra",
	["Sell a specific gem"] = "Vender una gema concreta",
	["Pick a gem to sell"] = "Elegir una gema para vender",
	["How are gems valued?"] = "¿Cómo se valoran las gemas?",
	["Rarity sets the base: one Legendary outweighs a pouch of Commons. Size, Clarity and Cut are each graded {1} to {2}, and every point raises the price."] = "La rareza marca la base: una Legendaria vale más que una bolsa de Comunes. Tamaño, Claridad y Talla se califican de {1} a {2}, y cada punto sube el precio.",
	["Which gems do you buy?"] = "¿Qué gemas compras?",
	["Any loose gem in your pouch. An appraisal only counts spares: gems used by any of your loadouts are left out."] = "Cualquier gema suelta de tu bolsa. Una tasación solo cuenta las de sobra: las gemas que usa cualquiera de tus equipamientos quedan fuera.",
	["Spare Commons: {1}. My offer: {2} coins."] = "Gemas comunes de sobra: {1}. Mi oferta: {2} monedas.",
	["Spare Uncommons: {1}. My offer: {2} coins."] = "Gemas poco comunes de sobra: {1}. Mi oferta: {2} monedas.",
	["Spare Commons: {1}, {2} coins. Spare Uncommons: {3}, {4} coins."] = "Gemas comunes de sobra: {1}, {2} monedas. Gemas poco comunes de sobra: {3}, {4} monedas.",
	["No spare Commons or Uncommons in your pouch. Choose a gem to sell, or bring more from the quarry."] = "No tienes gemas comunes ni poco comunes de sobra en tu bolsa. Elige una gema para vender, o trae más de la cantera.",
	["Sell my spare Commons ({1}) for {2} coins"] = "Vender mis gemas comunes de sobra ({1}) por {2} monedas",
	["Sell my spare Uncommons ({1}) for {2} coins"] = "Vender mis gemas poco comunes de sobra ({1}) por {2} monedas",
	["Ilsa buys gems at the GEM BUYER desk in the Gem Gallery."] = "Ilsa compra gemas en el mostrador COMPRA DE GEMAS de la Galería de Gemas.",
	["Brutus, arena master. The Uplink runs ranked 1v1 duels. Consecutive wins restore your swings; one loss resets the count."] = "Brutus, guía de la arena. El Enlace organiza duelos 1v1 clasificatorios. Las victorias seguidas te devuelven golpes; una derrota reinicia la cuenta.",
	["Find me a duel"] = "Búscame un duelo",
	["What does a win streak pay?"] = "¿Qué da una racha de victorias?",
	["First win: a tenth of your swings restored. Fifth: a quarter. Tenth: half, and the tournament title. A loss ends the run."] = "Primera victoria: recuperas una décima parte de tus golpes. Quinta: una cuarta parte. Décima: la mitad, y el título del torneo. Una derrota termina la racha.",
	["Any advice?"] = "¿Algún consejo?",
	["Watch for the wind-up, guard, then punish the opening. Your sword, chest and shield gems power Q, E and R: socket your best before you queue."] = "Atento a cuando carguen el golpe: ponte en guardia y castiga el hueco. Las gemas de tu espada, pecho y escudo dan poder a Q, E y R: engarza las mejores antes de entrar en la cola.",
	["Tamsin, trade broker. Every player listing for gems and gear clears through this board."] = "Tamsin, agente de comercio. Cada anuncio de gemas y equipo de los jugadores pasa por este tablero.",
	["How does the Market work?"] = "¿Cómo funciona el Mercado?",
	["List a gem or a piece of gear at your asking price, or make an offer on another miner's listing. Coins change hands when the sale clears."] = "Publica una gema o una pieza de equipo al precio que pidas, o haz una oferta por el anuncio de otro minero. Las monedas cambian de manos cuando se cierra la venta.",
	["Where do I get coins?"] = "¿Dónde consigo monedas?",
	["Sell spare gems to Ilsa at the Gem Gallery, complete your daily challenges, or sell on this board."] = "Véndele gemas de sobra a Ilsa en la Galería de Gemas, completa tus desafíos diarios o vende en este tablero.",
	["Borin, outfitter. Suits, helmets, picks and weapon skins. Everything on these stands is available in the Store."] = "Borin, estilista. Trajes, cascos, picos y aspectos de arma. Todo lo de estos expositores está disponible en la Tienda.",
	["Do skins change my stats?"] = "¿Los aspectos cambian mis estadísticas?",
	["No. Everything here is cosmetic. Your gear's rolls and socketed gems stay exactly as they are."] = "No. Todo lo de aquí es estético. Las tiradas de tu equipo y tus gemas engarzadas se quedan exactamente igual.",
	["Which section of the Store?"] = "¿Qué sección de la Tienda?",
	["Picks"] = "Picos",
	["Weapon skins"] = "Aspectos de arma",
	["Garrick, mining foreman. The quarry is through the main door. Every rock you break yields one gem. The richer ground is farther out, and so is the rift activity."] = "Garrick, capataz de minería. La cantera está al cruzar la puerta principal. Cada roca que rompes da una gema. El terreno más rico está más lejos, y también la actividad de las grietas.",
	["Where is the best ground?"] = "¿Dónde está el mejor terreno?",
	["Yield improves with distance. The Fringe starts {1} studs out, the Edge at {2}. Three Rift Veins surface by the crater walls; one of them is guarded."] = "El rendimiento mejora con la distancia. La Franja empieza a {1} studs y el Borde a {2}. Tres Vetas de la Grieta afloran junto a las paredes del cráter; una de ellas está vigilada.",
	["What are those critters?"] = "¿Qué son esos bichos?",
	["Rift critters. Activity rises the longer you work outside the Core. Keep your kaiju close: if your whole team goes down out there, the critters come for your gems."] = "Bichos de la Grieta. La actividad sube cuanto más tiempo trabajas fuera del Núcleo. Mantén cerca a tus kaiju: si cae todo tu equipo ahí fuera, los bichos vienen a por tus gemas.",
	["My swings ran out"] = "Me quedé sin golpes",
	["Your pick recharges a swing every {1} seconds. PROBE-{2} sells refills, and win streaks at Brutus's Uplink restore swings."] = "Tu pico recupera un golpe cada {1} segundos. La SONDA-{2} vende recargas, y las rachas de victorias en el Enlace de Brutus devuelven golpes.",
	-- INFO-9, the Shelter's information unit (Shared.Vendors.InfoBot, its
	-- field tips Vendors.Tips; Client.Dialogue): answers by topic, a tip at
	-- a time.
	["INFO-{1} // INFORMATION"] = "INFO-{1} // INFORMACIÓN",
	["INFO-{1}, Information"] = "INFO-{1}, información",
	["INFO-{1}, base information. Choose a topic, or ask for a field tip."] = "INFO-{1}, información de la base. Elige un tema o pide un consejo de campo.",
	["Give me a field tip"] = "Dame un consejo de campo",
	["What would you like to know?"] = "¿Qué quieres saber?",
	["Mining and gems"] = "Minería y gemas",
	["How does mining work?"] = "¿Cómo funciona la minería?",
	["Walk up to a rock and swing. Every rock yields one gem when it breaks, and broken rocks grow back. Crystal Boulders take more swings than Regolith Chunks, and their gems roll rarer."] = "Acércate a una roca y golpea. Cada roca da una gema al romperse, y las rocas rotas vuelven a crecer. Las Rocas de cristal piden más golpes que los Trozos de regolito, y sus gemas salen más raras.",
	["What are the odds?"] = "¿Qué probabilidades hay?",
	["For every gem: Common {1}%, Uncommon {2}%, Rare {3}%, Ultra-Rare {4}%, Legendary {5}%. Luck shifts those odds toward the rarer tiers."] = "Para cada gema: Común {1}%, Poco común {2}%, Rara {3}%, Ultra rara {4}%, Legendaria {5}%. La suerte inclina esas probabilidades hacia las más raras.",
	["Why mine farther out?"] = "¿Por qué minar más lejos?",
	["Luck. The Core around the Shelter is safe and adds none. Past {1} studs, the Fringe adds luck to every gem; past {2}, the Edge adds more. Rift activity rises with it."] = "Por la suerte. El Núcleo, alrededor del Refugio, es seguro y no añade nada. Pasados {1} studs, la Franja añade suerte a cada gema; pasados {2}, el Borde añade más. Con ella sube la actividad de las grietas.",
	["What do I do with spare gems?"] = "¿Qué hago con las gemas que me sobran?",
	["Sell them to Ilsa at the Gem Gallery for coins, list them on the Market, or use them to heal your kaiju."] = "Véndeselas a Ilsa en la Galería de Gemas por monedas, publícalas en el Mercado o úsalas para curar a tus kaiju.",
	["Kaiju"] = "Kaiju",
	["How do kaiju fight?"] = "¿Cómo luchan los kaiju?",
	["Your team of three follows you and fights on its own: they split up the targets and flank them. They also gain experience while you mine."] = "Tu equipo de tres te sigue y lucha por su cuenta: se reparten los objetivos y los flanquean. También ganan experiencia mientras minas.",
	["How do I heal them?"] = "¿Cómo los curo?",
	["Once you're clear of danger, open the kaiju panel's HEAL tab and give them gems. Rarer gems heal more, and a gem of their own element heals twice as much. AUTO HEAL spends Commons first, then Uncommons."] = "Cuando estés fuera de peligro, abre la pestaña CURAR del panel de kaiju y dales gemas. Las gemas más raras curan más, y una de su propio elemento cura el doble. AUTOCURA gasta primero las comunes y luego las poco comunes.",
	["One got knocked out"] = "Noquearon a uno",
	["It recovers on its own after a cooldown, longer at higher levels, and comes back at {1}% health: heal it with gems. Or revive it now for Robux, at half health."] = "Se recupera solo tras una espera, más larga a mayor nivel, y vuelve con un {1}% de salud: cúralo con gemas. O revívelo ya con Robux, con la mitad de su salud.",
	["How do I catch a wild kaiju?"] = "¿Cómo atrapo un kaiju salvaje?",
	["Challenge one in the quarry and wear it down below half health without knocking it out: it glows gold. Then press CATCH and hold it in your gem's light. Taking a hit or moving off breaks the catch."] = "Desafía a uno en la cantera y bájale la salud por debajo de la mitad sin noquearlo: brillará dorado. Entonces pulsa ATRAPAR y sujétalo con la luz de tu gema. Si recibes un golpe o te alejas, la captura se interrumpe.",
	["Threats and safety"] = "Amenazas y seguridad",
	["What are rift critters?"] = "¿Qué son los bichos de la Grieta?",
	["Hostiles that come through rifts beyond the Core, more often the longer you work out there. Hit them with your pick to drive them back: it costs no swings."] = "Hostiles que cruzan las grietas más allá del Núcleo, más a menudo cuanto más tiempo trabajas ahí fuera. Golpéalos con tu pico para hacerlos retroceder: no gasta golpes.",
	["What is a gem raid?"] = "¿Qué es un asalto de gemas?",
	["If your whole kaiju team is knocked out beyond the Core, critters trip you and steal the newest gems from your trip. Hit a thief before it reaches its rift and the gem comes back. Back in the Core, your gems are safe."] = "Si noquean a todo tu equipo de kaiju más allá del Núcleo, los bichos te ponen la zancadilla y roban las gemas más nuevas de tu salida. Golpea al ladrón antes de que llegue a su grieta y recuperas la gema. De vuelta en el Núcleo, tus gemas están a salvo.",
	["How do I recover health?"] = "¿Cómo recupero salud?",
	["In the Outpost you heal on your own: a few seconds after your last hit, your health starts to refill. Sparring and being knocked down pause it."] = "En el Puesto te curas solo: unos segundos después del último golpe, tu salud empieza a llenarse. Un combate amistoso o estar derribado lo detienen.",
	["Your free pick gets a swing back every {1} seconds and is full again in two hours. PROBE-{2} sells refills, and 1v1 win streaks at the Arena Uplink restore swings."] = "Tu pico gratis recupera un golpe cada {1} segundos y vuelve a estar lleno en dos horas. La SONDA-{2} vende recargas, y las rachas de victorias en 1v1 del Enlace de la Arena devuelven golpes.",
	-- INFO-9's field tips (Vendors.Tips).
	["Every rock yields exactly one gem, and broken rocks grow back. A picked-over field fills up again."] = "Cada roca da exactamente una gema, y las rocas rotas vuelven a crecer. Un campo agotado se vuelve a llenar.",
	["The Fringe starts {1} studs from the Shelter and adds luck to every gem. The Edge starts at {2} and adds more."] = "La Franja empieza a {1} studs del Refugio y añade suerte a cada gema. El Borde empieza a {2} y añade más.",
	["Three Rift Veins surface by the crater walls and move from time to time. They are the richest ground in the quarry."] = "Tres Vetas de la Grieta afloran junto a las paredes del cráter y se mueven de vez en cuando. Son el terreno más rico de la cantera.",
	["One Rift Vein is guarded. Bring your whole team before you go near it."] = "Una Veta de la Grieta está vigilada. Lleva a todo tu equipo antes de acercarte.",
	["Clear a wandering rift and every miner who helped is Rift Charged: luckier gems for {1} seconds."] = "Despeja una grieta errante y cada minero que ayudó queda con Grieta cargada: gemas con más suerte durante {1} segundos.",
	["Your free pick gets a swing back every {1} seconds. A full charge takes two hours."] = "Tu pico gratis recupera un golpe cada {1} segundos. Una carga completa tarda dos horas.",
	["Swings bought from PROBE-{1} are used before your free charge."] = "Los golpes comprados a la SONDA-{1} se usan antes que tu carga gratis.",
	["Rift activity rises the longer you work beyond the Core."] = "La actividad de las grietas sube cuanto más tiempo trabajas más allá del Núcleo.",
	["Your pick drives critters back, and hitting them costs no swings."] = "Tu pico hace retroceder a los bichos, y golpearlos no gasta golpes.",
	["A critter winding up a TRIP shows it on its cast bar. Step out of reach or hit it to cancel it."] = "Un bicho que prepara una ZANCADILLA la muestra en su barra de lanzamiento. Sal de su alcance o golpéalo para cancelarla.",
	["If your whole kaiju team goes down beyond the Core, critters raid your gems. Hit a thief before it reaches its rift to get the gem back."] = "Si cae todo tu equipo de kaiju más allá del Núcleo, los bichos asaltan tus gemas. Golpea al ladrón antes de que llegue a su grieta para recuperar la gema.",
	["Only loose gems from your current trip can be stolen. Gems socketed in your gear are always safe."] = "Solo se pueden robar gemas sueltas de tu salida actual. Las gemas engarzadas en tu equipo siempre están a salvo.",
	["Gems from your trip are safe again once you're back in the Core."] = "Las gemas de tu salida vuelven a estar a salvo en cuanto regresas al Núcleo.",
	["In the Outpost your health refills on its own a few seconds after your last hit."] = "En el Puesto tu salud se llena sola unos segundos después del último golpe.",
	["A creature's outline shows its health: green is healthy, amber is worn down, red is nearly done."] = "El contorno de una criatura muestra su salud: verde es sana, ámbar es desgastada, rojo es casi vencida.",
	["Wild kaiju and gem thieves stay outlined through rocks and walls, so you can track them."] = "Los kaiju salvajes y los ladrones de gemas siguen marcados a través de rocas y paredes, para que puedas seguirlos.",
	["Kaiju don't heal on their own. Give them gems once you're clear of danger."] = "Los kaiju no se curan solos. Dales gemas cuando estés fuera de peligro.",
	["A gem of a kaiju's own element heals it twice as much."] = "Una gema del propio elemento de un kaiju lo cura el doble.",
	["AUTO HEAL spends spare Commons first, then Uncommons. It never uses a rarer gem or one your loadouts use."] = "AUTOCURA gasta primero las comunes de sobra y luego las poco comunes. Nunca usa una gema más rara ni una que usen tus equipamientos.",
	["Kaiju gain experience while you mine, even when they aren't fighting."] = "Los kaiju ganan experiencia mientras minas, aunque no estén luchando.",
	["A knocked-out kaiju comes back on its own after a cooldown. The higher its level, the longer it takes."] = "Un kaiju noqueado vuelve solo tras una espera. Cuanto mayor es su nivel, más tarda.",
	["To catch a wild kaiju, wear it down below half health without knocking it out. It glows gold when it's ready."] = "Para atrapar un kaiju salvaje, bájale la salud por debajo de la mitad sin noquearlo. Brilla dorado cuando está listo.",
	["A catch breaks if you take a hit or move away. Clear the area first."] = "Una captura se interrumpe si recibes un golpe o te alejas. Despeja la zona primero.",
	["To start a kaiju battle, tap KAIJU on another miner's card. You both get {1} seconds to set your formation."] = "Para empezar una batalla de kaiju, toca KAIJU en la tarjeta de otro minero. Cada uno tiene {1} segundos para preparar su formación.",
	["Bulwarks and Carapaces take hits well: put them in the front row of a battle formation."] = "Los Bulwark y los Carapace aguantan bien los golpes: ponlos en la fila de delante de la formación.",
	["Razorbacks fight at range: keep them in the back row of a battle formation."] = "Los Razorback luchan a distancia: mantenlos en la fila de atrás de la formación.",
	["Hold your swing and release it on gold for a perfect hit."] = "Mantén el golpe y suéltalo en el dorado para un golpe perfecto.",
	["Your sword's gem gives you Q, your chest's E and your shield's R. Swap a gem to swap the move."] = "La gema de tu espada te da Q, la de tu pecho E y la de tu escudo R. Cambia una gema para cambiar el movimiento.",
	["Thermal beats Cryo, Cryo beats Ion, Ion beats Corrosive and Corrosive beats Thermal."] = "Térmico vence a Crio, Crio vence a Iónico, Iónico vence a Corrosivo y Corrosivo vence a Térmico.",
	["Press {1} to ask the nearest miner to spar. In a spar, only the two of you can hit each other."] = "Pulsa {1} para pedir un combate amistoso al minero más cercano. En el combate, solo ustedes dos pueden golpearse.",
	["Arena win streaks restore swings: a tenth on the first win, a quarter on the fifth, half on the tenth."] = "Las rachas de victorias en la arena devuelven golpes: una décima parte en la primera victoria, una cuarta parte en la quinta, la mitad en la décima.",
	["A loss ends your win streak. Choose your duels carefully."] = "Una derrota termina tu racha. Elige bien tus duelos.",
	["Ilsa never makes an offer for gems your loadouts use, so selling your spares is safe."] = "Ilsa nunca hace ofertas por las gemas que usan tus equipamientos, así que vender las de sobra es seguro.",
	["Skins never change stats. Your gear's rolls and gems stay as they are."] = "Los aspectos nunca cambian las estadísticas. Las tiradas y las gemas de tu equipo se quedan igual.",
	["The Store's stands change every {1} seconds. Wait a few minutes to see everything on sale."] = "Los expositores de la Tienda cambian cada {1} segundos. Espera unos minutos para ver todo lo que está a la venta.",
	["Mechs are parked in Bays {1} to {2}. Drive out either garage door and down its ramp."] = "Los mechs están aparcados en las Bahías {1} a {2}. Sal por cualquiera de las puertas del garaje y baja por su rampa.",
	["Mechs are for getting around. They can't mine or fight."] = "Los mechs sirven para moverse. No pueden minar ni luchar.",
	["Invite a friend: when they join, you get a swing restore, a kaiju revive and a double XP coupon."] = "Invita a un amigo: cuando se una, recibes un cupón de Recuperar golpes, uno de Revivir kaiju y uno de XP doble.",
