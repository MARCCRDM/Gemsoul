{
  "name": "Gemsoul",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "Orientation": {
        "$path": "src/first/Orientation.client.luau"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultTextChannels": true,
        "CreateDefaultCommands": true
      }
    }
  }
}
