Party.start()
Queue.start()
local a,b,c=makePlayer(301,"A"),makePlayer(302,"B"),makePlayer(303,"C")
check(handlers.DungeonFind(a).Ok,"Solo rejected")
check(not handlers.DungeonFind(a).Ok,"Duplicate accepted")
handlers.DungeonFind(b)
Queue.step()
check(#launches==0,"Launched below three")
handlers.DungeonFind(c)
Queue.step()
check(#launches==1,"Three solos did not launch")
check(Party.of(a)==Party.of(b) and Party.of(b)==Party.of(c),"Matched players not one party")
check(#Party.of(a).Members==3 and Party.of(a).Ready[b],"Matched trio not ready")
check(not a:GetAttribute("DungeonQueue"),"Queue flag leaked")
Queue.step()
check(#launches==1,"Duplicate launch")
local d,e,f=makePlayer(304,"D"),makePlayer(305,"E"),makePlayer(306,"F")
check(handlers.PartyInvite(d,e.UserId).Ok,"Invite failed")
check(handlers.PartyRespond(e,d.UserId,true).Ok,"Accept failed")
check(not handlers.DungeonFind(d).Ok,"Unready duo queued")
handlers.PartyReady(d,true);handlers.PartyReady(e,true)
check(not handlers.DungeonFind(e).Ok,"Nonleader queued duo")
check(handlers.DungeonFind(d).Ok,"Ready duo rejected")
handlers.DungeonFind(f);Queue.step()
check(#launches==2 and Party.of(d)==Party.of(f) and Party.of(e)==Party.of(f),"Duo plus solo failed")
local g,h,i=makePlayer(307,"G"),makePlayer(308,"H"),makePlayer(309,"I")
handlers.DungeonFind(g);handlers.DungeonFind(h)
check(handlers.DungeonCancel(g).Ok,"Cancel failed")
handlers.DungeonFind(i);Queue.step()
check(#launches==2,"Cancelled player matched")
h:SetAttribute("CombatSession","Training");Queue.step()
check(not h:GetAttribute("DungeonQueue"),"Busy player stayed queued")
Players.PlayerRemoving.Fire(i)
check(not i:GetAttribute("DungeonQueue"),"Disconnect leaked reservation")
check(Party.matchDungeon({d,g,h})==nil,"Match split an existing party")
local j,k=makePlayer(310,"J"),makePlayer(311,"K")
handlers.PartyInvite(j,k.UserId);handlers.PartyRespond(k,j.UserId,true)
handlers.PartyReady(j,true);handlers.PartyReady(k,true)
handlers.DungeonFind(j);handlers.PartyReady(k,false);Queue.step()
check(not j:GetAttribute("DungeonQueue") and not k:GetAttribute("DungeonQueue"),"Unready member did not cancel duo")
print("PASS: "..checks.." dungeon matchmaking checks: solo, duo, consent, cancellation, disconnect, busy state, duplicates and party preservation")
